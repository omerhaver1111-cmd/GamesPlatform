<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@drawable/background2"
    tools:context=".screens.LeaderBordActivity">

    <ScrollView
        android:layout_width="364dp"
        android:layout_height="773dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView6"
                android:layout_width="wrap_content"
                android:layout_height="41dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Car Escape"
                android:textColor="#D4B2DE"
                android:textSize="22sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/cars_bord"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardBackgroundColor="#C5B3BEE0"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_car"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                </androidx.recyclerview.widget.RecyclerView>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView11"
                android:layout_width="wrap_content"
                android:layout_height="41dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Snake"
                android:textColor="#D4B2DE"
                android:textSize="22sp" />

            <androidx.cardview.widget.CardView
                android:id="@+id/snake_bord"
                android:layout_width="match_parent"
                android:layout_height="250dp"
                app:cardBackgroundColor="#C5B3BEE0"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_snake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/textView13"
                android:layout_width="wrap_content"
                android:layout_height="41dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Piano"
                android:textColor="#D4B2DE"
                android:textSize="22sp" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="215dp"
                app:cardBackgroundColor="#C5B3BEE0"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_piano"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>