<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:background="@drawable/background1_1"
    tools:context=".screens.MyGroupActivity">

    <LinearLayout
        android:id="@+id/linearLayout3"
        android:layout_width="408dp"
        android:layout_height="722dp"
        android:layout_margin="5dp"
        android:orientation="vertical"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.cardview.widget.CardView
            android:id="@+id/my_group_cardv"
            android:layout_width="match_parent"
            android:layout_height="617dp"
            app:cardBackgroundColor="#C5B3BEE0"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <ImageView
                    android:id="@+id/img_group_banner"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background" />

                <LinearLayout
                    android:id="@+id/my_group_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:paddingTop="180dp">

                    <TextView
                        android:id="@+id/tv_group_name_my_group"
                        android:layout_width="match_parent"
                        android:layout_height="41dp"
                        android:layout_marginBottom="16dp"
                        android:gravity="bottom|center"
                        android:text="My Group"
                        android:textColor="?attr/colorOnBackground"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_user_count_my_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="TextView" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_my_group_users"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_user" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btn_leave_group"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Leave Group" />

                        <Button
                            android:id="@+id/btn_upload_banner"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload Banner" />
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

        </androidx.cardview.widget.CardView>


    </LinearLayout>

    <TextView
        android:id="@+id/tv_mygroup_loading"
        android:layout_width="460dp"
        android:layout_height="794dp"
        android:background="#2B425B"
        android:gravity="center"
        android:text="loading..."
        android:textColor="@color/white"
        android:textSize="20dp"
        app:layout_constraintBottom_toTopOf="@+id/linearLayout7"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/linearLayout7"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/linearLayout3">

        <Button
            android:id="@+id/btn_group"
            android:layout_width="137dp"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#00FFFFFF"
            android:text="group"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_group_home"
            android:layout_width="137dp"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#00FFFFFF"
            android:text="home"
            android:textSize="20sp" />

        <Button
            android:id="@+id/btn_group_info"
            android:layout_width="137dp"
            android:layout_height="130dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="4dp"
            android:backgroundTint="#00FFFFFF"
            android:text="info"
            android:textSize="24sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>